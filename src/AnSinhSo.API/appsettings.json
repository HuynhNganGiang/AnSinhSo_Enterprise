{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AnSinhSoDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379,abortConnect=false,ssl=false"
  },
  "Jwt": {
    "SecretKey": "AnSinhSo_Enterprise_SecretKey_2026_1234567890",
    "Issuer": "AnSinhSo.Api",
    "Audience": "AnSinhSo.Clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "ClockSkewSeconds": 0,
    "SigningAlgorithm": "HS256"
  },
  "ZaloOA": {
    "AppId": "YOUR_ZALO_APP_ID",
    "AppSecret": "YOUR_ZALO_APP_SECRET",
    "AccessToken": "YOUR_INITIAL_ACCESS_TOKEN",
    "RefreshToken": "YOUR_INITIAL_REFRESH_TOKEN"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ansinhso-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
